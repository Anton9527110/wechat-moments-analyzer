# 复制为 /etc/wechat-moments-proxy.env 后填写（权限 600，勿提交 Git）
DASHSCOPE_API_KEY=sk-请替换为百炼业务空间Key
ALLOWED_MODELS=qwen3-vl-flash-2025-10-15,qwen3-vl-flash,qwen3-vl-plus,qwen-vl-plus,qwen2.5-vl-72b-instruct
MAX_RPM=6
MAX_RPD=30
MAX_GLOBAL_RPD=300
MAX_BODY_BYTES=26214400
PORT=8787
HOST=127.0.0.1
# 逗号分隔；IP 访问时 Origin 为 http://x.x.x.x 也会被代码放行
CORS_ORIGIN=https://anton9527110.github.io
